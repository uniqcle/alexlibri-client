generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Section {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
}


model Period {
  id    String @id @default(cuid())
  name  String @unique   // "VIII в. до н.э.", "I в. н.э."
  slug  String @unique   // "viii-bc", "i-ad"
  order Int    @unique   // Порядковый номер для хронологической сортировки

  // books Book[]   ← раскомментируем, когда создадим модель Book
}


model Genre {
  id    String @id @default(cuid())
  name  String @unique   // "Роман" 
  slug  String @unique   // "roman" 

  // Зеркальное поле связи: массив книг. В базе данных колонки НЕТ.
  // Раскомментируем, когда создадим модель Book с неявной m-n.
  // books Book[]
}


model Culture {
  id    String @id @default(cuid())
  name  String @unique   // "Греческая", "Римская"
  slug  String @unique   // "greek", "roman"

  authors Author[]
}



model Author {
  id            String  @id @default(cuid())
  name          String?           // короткое имя ("Гомер")
  fullName      String            // полное имя ("Гомер")
  dateLife      String?           // "VIII в. до н.э."
  shortText     String? @db.Text  // краткое описание
  biographyHtml String? @db.Text  // биография в HTML
  photo         String?           // имя файла фото
  slug          String  @unique   // "gomer"
  commentTimey  String? @db.Text  // текстовый комментарий персонажа Тимей


  culture   Culture? @relation(fields: [cultureId], references: [id], onDelete: Restrict)
  cultureId String?

  // books Book[]   ← раскомментируем, когда создадим Book
}


model Translator {
  id        String @id @default(cuid())
  name      String?          
  fullName  String           
  dateLife  String?         
  shortText String? @db.Text    
  biographyHtml String? @db.Text  
  slug      String @unique  // "gomerovskiy-perevodchik", "ginzburg"
  photo String?

  // Зеркальное поле связи: все книги этого переводчика.
  // В базе данных колонки нет — нужно только для запросов.
  // books Book[]
}